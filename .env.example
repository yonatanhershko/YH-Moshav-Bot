# ---------- Telegram ----------
# מ-@BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# ה-chat id שלך (תריץ: npm run telegram:chatid)
TELEGRAM_CHAT_ID=123456789

# ---------- Supabase ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
# השתמש ב-service_role key (לא ה-anon) כדי לכתוב לטבלה
SUPABASE_KEY=eyJhbGci...

# ---------- Facebook (אופציונלי) ----------
FB_ENABLED=true
# שיטה מומלצת: להריץ פעם אחת מקומית `npm run fb:auth`,
# להעתיק את ה-base64 שמודפס לכאן (מונע התחברות מחדש בכל ריצה = פחות סיכון לחסימה)
FB_STORAGE_STATE_B64=
# fallback בלבד אם אין storage state:
FB_EMAIL=
FB_PASSWORD=

# ---------- תזמון ----------
# כל כמה זמן לבדוק (cron). ברירת מחדל: כל 30 דקות
CHECK_CRON=*/30 * * * *
# הרצה מיידית עם העלייה?
RUN_ON_BOOT=true

# ---------- שרת ----------
PORT=3000

# ---------- מצב בדיקה ----------
# true = לא שולח טלגרם ולא כותב ל-DB, רק מדפיס מה נמצא
DRY_RUN=false
